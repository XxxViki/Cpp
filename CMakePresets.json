{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "description": "所有 preset 的公共配置",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "17",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "CMAKE_CXX_EXTENSIONS": "OFF",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "mingw-debug",
      "displayName": "MinGW Debug",
      "description": "MinGW-w64 编译器，Debug 模式",
      "inherits": "base",
      "generator": "MinGW Makefiles",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "mingw-release",
      "displayName": "MinGW Release",
      "description": "MinGW-w64 编译器，Release 模式",
      "inherits": "base",
      "generator": "MinGW Makefiles",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "msvc-debug",
      "displayName": "MSVC Debug",
      "description": "Visual Studio MSVC 编译器，Debug 模式",
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "msvc-release",
      "displayName": "MSVC Release",
      "description": "Visual Studio MSVC 编译器，Release 模式",
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "gcc-debug",
      "displayName": "GCC Debug (Linux / Dev Container)",
      "description": "Linux GCC 编译器，Debug 模式",
      "inherits": "base",
      "generator": "Unix Makefiles",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "gcc-release",
      "displayName": "GCC Release (Linux / Dev Container)",
      "description": "Linux GCC 编译器，Release 模式",
      "inherits": "base",
      "generator": "Unix Makefiles",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "default",
      "displayName": "默认 (MinGW Debug)",
      "description": "默认构建预设：MinGW Debug，Dev Container 请用 gcc-debug",
      "inherits": "mingw-debug"
    }
  ],
  "buildPresets": [
    {
      "name": "mingw-debug",
      "displayName": "构建 MinGW Debug",
      "configurePreset": "mingw-debug",
      "configuration": "Debug"
    },
    {
      "name": "mingw-release",
      "displayName": "构建 MinGW Release",
      "configurePreset": "mingw-release",
      "configuration": "Release"
    },
    {
      "name": "msvc-debug",
      "displayName": "构建 MSVC Debug",
      "configurePreset": "msvc-debug",
      "configuration": "Debug"
    },
    {
      "name": "msvc-release",
      "displayName": "构建 MSVC Release",
      "configurePreset": "msvc-release",
      "configuration": "Release"
    },
    {
      "name": "gcc-debug",
      "displayName": "构建 GCC Debug",
      "configurePreset": "gcc-debug",
      "configuration": "Debug"
    },
    {
      "name": "gcc-release",
      "displayName": "构建 GCC Release",
      "configurePreset": "gcc-release",
      "configuration": "Release"
    },
    {
      "name": "default",
      "displayName": "默认构建",
      "configurePreset": "default"
    }
  ]
}
